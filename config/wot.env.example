# ---------------------------------------------------------------------------
# WoT Smart-Building Gateway - single configuration file
# Read by: systemd units (EnvironmentFile), Node.js services, Python devices.
# install.sh copies this to config/wot.env on first install. Edit wot.env, then:
#     ./wotctl restart
# ---------------------------------------------------------------------------

# Host/IP written into Thing Description hrefs. "auto" = first IPv4 address
# reported by `hostname -I` (falls back to 127.0.0.1 when there is no network).
WOT_HOST=auto

# --- Network ports ----------------------------------------------------------
MQTT_PORT=1883            # Mosquitto broker
COAP_PORT=5683            # CoAP fan relay (UDP)
PLUG_HTTP_PORT=8091       # simulated HTTP smart plug
DIRECTORY_PORT=8090       # Thing Description Directory + dashboard
GATEWAY_HTTP_PORT=8080    # node-wot gateway - HTTP interface
GATEWAY_WS_PORT=8081      # node-wot gateway - WebSocket interface
APP_PORT=8082             # climate-controller application (its own Thing)
SIM_HTTP_PORT=8092        # simulated devices (scalability / latency tests)
SIM_COAP_PORT=5684        # simulated devices (UDP)

# --- DHT22 temperature sensor (MQTT device) --------------------------------
DHT_GPIO=4                # BCM pin number of the DHT22 DATA line
# auto     = kernel driver (dtoverlay=dht11) -> adafruit library -> simulation
# kernel   = only the kernel IIO driver
# adafruit = only adafruit-circuitpython-dht
# sim      = simulated temperature (no hardware needed)
DHT_BACKEND=auto
SENSOR_INTERVAL_S=2       # DHT22 cannot be read faster than every 2 s

# --- Fan relay / LED (CoAP device, swappable to MQTT) ----------------------
RELAY_GPIO=17             # BCM pin number driving the relay IN pin (or LED)
RELAY_ACTIVE_HIGH=false   # most blue relay boards are active-LOW; LED = true
RELAY_MOCK=false          # true = no GPIO (laptop development only); on the Pi a GPIO error stops the service
RELAY_TD=things/fan-relay.td.json   # the ONLY file the protocol swap changes

# --- Application rule -------------------------------------------------------
TEMP_THRESHOLD_C=28.0     # fan ON above this
TEMP_HYSTERESIS_C=1.0     # fan OFF below threshold - hysteresis
APP_MODE=gateway          # gateway = use proxied TDs; direct = use device TDs
NOTIFY_URL=               # optional webhook (e.g. http://ntfy.local/alerts); empty = log only

# --- Gateway / directory ----------------------------------------------------
GATEWAY_SYNC_INTERVAL_S=3 # how often the gateway polls the directory
GATEWAY_GRACE_S=20        # keep a proxy alive this long after its device disappears
GATEWAY_READ_TIMEOUT_MS=5000
DIRECTORY_TTL_S=60        # registrations expire unless refreshed (devices refresh every TTL/3)

# Log level for node-wot internals (error|warn|info|debug)
LOG_LEVEL=info
