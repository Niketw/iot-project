{
  "@context": [
    "https://www.w3.org/2022/wot/td/v1.1",
    {
      "saref": "https://w3id.org/saref#",
      "bldg": "https://example.org/smart-building#",
      "cov": "http://www.example.org/coap-binding#",
      "mqv": "http://www.example.org/mqtt-binding#"
    }
  ],
  "@type": ["saref:Switch", "bldg:FanController"],
  "id": "urn:wot:device:fan-relay-1",
  "title": "Fan Relay",
  "description": "Relay module (or LED) switching a small DC fan. Native protocol: CoAP.",
  "securityDefinitions": { "nosec_sc": { "scheme": "nosec" } },
  "security": "nosec_sc",
  "properties": {
    "on": {
      "title": "Fan is on",
      "type": "boolean",
      "observable": false,
      "forms": [
        {
          "href": "coap://{{WOT_HOST}}:{{COAP_PORT}}/fan/properties/on",
          "op": ["readproperty"],
          "cov:method": "GET",
          "contentType": "application/json"
        },
        {
          "href": "coap://{{WOT_HOST}}:{{COAP_PORT}}/fan/properties/on",
          "op": ["writeproperty"],
          "cov:method": "PUT",
          "contentType": "application/json"
        }
      ]
    }
  },
  "actions": {
    "turnOn": {
      "title": "Switch the fan on",
      "idempotent": true,
      "forms": [
        { "href": "coap://{{WOT_HOST}}:{{COAP_PORT}}/fan/actions/turnOn", "op": ["invokeaction"], "cov:method": "POST", "contentType": "application/json" }
      ]
    },
    "turnOff": {
      "title": "Switch the fan off",
      "idempotent": true,
      "forms": [
        { "href": "coap://{{WOT_HOST}}:{{COAP_PORT}}/fan/actions/turnOff", "op": ["invokeaction"], "cov:method": "POST", "contentType": "application/json" }
      ]
    },
    "toggle": {
      "title": "Toggle the fan",
      "forms": [
        { "href": "coap://{{WOT_HOST}}:{{COAP_PORT}}/fan/actions/toggle", "op": ["invokeaction"], "cov:method": "POST", "contentType": "application/json" }
      ]
    }
  },
  "events": {
    "stateChanged": {
      "title": "Fan state changed",
      "data": {
        "type": "object",
        "properties": {
          "on": { "type": "boolean" },
          "ts": { "type": "number" },
          "seq": { "type": "integer" }
        },
        "required": ["on", "ts"]
      },
      "forms": [
        {
          "href": "coap://{{WOT_HOST}}:{{COAP_PORT}}/fan/events/stateChanged",
          "op": ["subscribeevent", "unsubscribeevent"],
          "subprotocol": "cov:observe",
          "contentType": "application/json"
        }
      ]
    }
  }
}
